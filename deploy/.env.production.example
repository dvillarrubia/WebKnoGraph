# =============================================================================
# WebKnoGraph - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in the actual values.
# The DBs (PostgreSQL/pgvector and Neo4j) must already be running
# on the same Docker network (webknograph-network).
# =============================================================================

# --- General ---
DEBUG=false

# --- PostgreSQL / Supabase (pgvector) ---
# Use the container name as host (same Docker network)
SUPABASE_URL=http://supabase-db:8000
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_DB_HOST=supabase-db
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-db-password

# --- Neo4j ---
# Use the container name as host (same Docker network)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# --- LLM API Keys ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
GEMINI_API_KEY=

# --- Embedding Model (local) ---
# Default: Spanish model (768 dims). Alternative: intfloat/multilingual-e5-large (1024 dims)
EMBEDDING_MODEL_NAME=hiiamsid/sentence_similarity_spanish_es
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# --- RAG Configuration ---
RAG_TOP_K_VECTORS=10
RAG_GRAPH_HOPS=2
RAG_MAX_CONTEXT_PAGES=15
RAG_MIN_SIMILARITY=0.5
RAG_CONTEXT_MAX_TOKENS=8000
RAG_USE_RERANKING=true
RERANKING_MODEL=BAAI/bge-reranker-v2-m3
RERANKING_PAGERANK_WEIGHT=0.1

# --- Crawler Service ---
CRAWLER_SERVICE_URL=http://crawler-service:8081
CRAWL_OUTPUT_DIR=/app/data/crawl4ai_data

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8080
WEB_CONCURRENCY=2
